# Ortam değişkenleri. Bu dosya yalnızca adları ve biçimi gösterir; gerçek değer buraya YAZILMAZ.
# Yerelde: bu dosyayı .env.local olarak kopyalayıp değerleri orada doldurun (.env.local depoya girmez).
# Canlıda: aynı adlar Vercel → Project → Settings → Environment Variables altında tanımlanır.

# --- Tarayıcıya giden (VITE_ önekli) değişkenler: GİZLİ DEĞİLDİR, paket içinde herkes okuyabilir ---

# Katalog QR kodunun adresi. Boşsa sayfanın kendi adresinden üretilir.
VITE_CATALOG_URL=

# API'nin kök adresi. Boşsa istekler sayfanın kendi alan adına gider (/api/...).
# "mock:" ağ isteği yapmadan başarıyı, "mock:fail" başarısızlığı dener.
VITE_API_URL=

# --- Sunucu sırları: yalnızca /api fonksiyonu okur. Asla VITE_ öneki verilmez ---

# Taleplerin iletildiği webhook adresi (webhook.site ya da n8n).
# Yerelde boşsa olay sunucu günlüğüne yazılır (mock); canlıda zorunludur.
WEBHOOK_URL=

# Webhook imzası (X-Atolyekart-Signature, HMAC-SHA256) için gizli anahtar. Canlıda zorunludur.
# Üretmek için:  openssl rand -hex 32
WEBHOOK_SECRET=

# /api/admin/orders için JWT imza anahtarı (HS256). En az 32 karakter.
# Üretmek için:  openssl rand -hex 32   — canlı ve yerel için AYRI değer kullanın.
JWT_SECRET=
