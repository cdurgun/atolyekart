{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/luna-preview", "destination": "/luna-preview/", "permanent": false },
    { "source": "/eski-tasarim", "destination": "/eski-tasarim/", "permanent": false }
  ],
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }]
}
